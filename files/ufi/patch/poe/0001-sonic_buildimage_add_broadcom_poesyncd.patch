From: fengkm <chifeng.km@gmail.com>
Date: Thu, 21 May 2026 15:58:23 +0800
Subject: [PATCH] sonic-buildimage add broadcom poesyncd

---
 platform/broadcom/docker-poesyncd-brcm.dep    | 11 ++++
 platform/broadcom/docker-poesyncd-brcm.mk     | 22 ++++++++
 .../docker-poesyncd-brcm/Dockerfile.j2        | 38 ++++++++++++++
 .../docker-poesyncd-brcm/critical_processes   |  1 +
 .../broadcom/docker-poesyncd-brcm/start.sh    | 14 ++++++
 .../docker-poesyncd-brcm/supervisord.conf     | 50 +++++++++++++++++++
 platform/broadcom/rules.dep                   |  1 +
 platform/broadcom/rules.mk                    |  1 +
 8 files changed, 138 insertions(+)
 create mode 100644 platform/broadcom/docker-poesyncd-brcm.dep
 create mode 100644 platform/broadcom/docker-poesyncd-brcm.mk
 create mode 100644 platform/broadcom/docker-poesyncd-brcm/Dockerfile.j2
 create mode 100644 platform/broadcom/docker-poesyncd-brcm/critical_processes
 create mode 100755 platform/broadcom/docker-poesyncd-brcm/start.sh
 create mode 100644 platform/broadcom/docker-poesyncd-brcm/supervisord.conf

diff --git a/platform/broadcom/docker-poesyncd-brcm.dep b/platform/broadcom/docker-poesyncd-brcm.dep
new file mode 100644
index 000000000..266c2848c
--- /dev/null
+++ b/platform/broadcom/docker-poesyncd-brcm.dep
@@ -0,0 +1,11 @@
+#DPKG FRK
+DPATH       := $($(DOCKER_POESYNCD_BASE)_PATH)
+DEP_FILES   := $(SONIC_COMMON_FILES_LIST) platform/broadcom/docker-poesyncd-brcm.mk platform/broadcom/docker-poesyncd-brcm.dep
+DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
+DEP_FILES   += $(shell git ls-files $(DPATH))
+
+$(DOCKER_POESYNCD_BASE)_CACHE_MODE  := GIT_CONTENT_SHA
+$(DOCKER_POESYNCD_BASE)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST)
+$(DOCKER_POESYNCD_BASE)_DEP_FILES   := $(DEP_FILES)
+
+$(eval $(call add_dbg_docker,$(DOCKER_POESYNCD_BASE),$(DOCKER_POESYNCD_BASE_DBG)))
diff --git a/platform/broadcom/docker-poesyncd-brcm.mk b/platform/broadcom/docker-poesyncd-brcm.mk
new file mode 100644
index 000000000..134a0cd03
--- /dev/null
+++ b/platform/broadcom/docker-poesyncd-brcm.mk
@@ -0,0 +1,22 @@
+# docker image for vs poesyncd
+
+UFI_POE_SAI = libsaiufi_amd64.deb
+$(UFI_POE_SAI)_PATH = files/ufi/lib/
+SONIC_COPY_DEBS += $(UFI_POE_SAI)
+$(UFI_POE_SAI)_SKIP_VERSION=y
+
+DOCKER_POESYNCD_PLATFORM_CODE = brcm
+include $(PLATFORM_PATH)/../template/docker-poesyncd-base.mk
+
+$(DOCKER_POESYNCD_BASE)_DEPENDS += $(SYNCD)
+$(DOCKER_POESYNCD_BASE)_DEPENDS += $(UFI_POE_SAI)
+
+$(DOCKER_POESYNCD_BASE)_DBG_DEPENDS += $(SYNCD_DBG) \
+                                $(LIBSWSSCOMMON_DBG) \
+                                $(LIBSAIMETADATA_DBG) \
+                                $(LIBSAIREDIS_DBG)
+
+$(DOCKER_POESYNCD_BASE)_VERSION = 1.0.0
+$(DOCKER_POESYNCD_BASE)_PACKAGE_NAME = poesyncd
+
+$(DOCKER_POESYNCD_BASE)_RUN_OPT += -v /host/warmboot:/var/warmboot
diff --git a/platform/broadcom/docker-poesyncd-brcm/Dockerfile.j2 b/platform/broadcom/docker-poesyncd-brcm/Dockerfile.j2
new file mode 100644
index 000000000..3499fb6c8
--- /dev/null
+++ b/platform/broadcom/docker-poesyncd-brcm/Dockerfile.j2
@@ -0,0 +1,38 @@
+FROM docker-config-engine-bookworm-{{DOCKER_USERNAME}}:{{DOCKER_USERTAG}}
+
+ARG docker_container_name
+
+## Make apt-get non-interactive
+ENV DEBIAN_FRONTEND=noninteractive
+
+RUN apt-get update
+
+RUN apt-get install -f -y iproute2 libcap2-bin lz4
+
+# For DASH engine
+
+COPY debs/libnl-3-dev_*_amd64.deb debs/libnl-route-3-dev_*_amd64.deb debs/
+RUN dpkg -i debs/libnl-3-dev_*_amd64.deb debs/libnl-route-3-dev_*_amd64.deb
+
+RUN apt-get install -f -y libabsl20220623 libc-ares2 python3-six libboost-thread1.74.0 libboost-dev libboost-system-dev libboost-thread-dev libboost-filesystem1.74.0 libboost-program-options1.74.0 libboost-thread1.74.0 libnanomsg5 libpcap0.8 libthrift-0.17.0 libboost-dev libboost-filesystem-dev libboost-program-options-dev libgmp-dev libnanomsg-dev libpcap-dev libtool pkg-config libthrift-dev python3-thrift thrift-compiler libboost-iostreams1.74.0 libgc1 cpp libboost-dev libboost-all-dev libboost-graph-dev libboost-iostreams-dev libfl-dev libgc-dev libgmp-dev libbpf-dev tcpdump libelf-dev llvm clang python3-pyroute2 python3-ply python3-scapy python3-setuptools python3-thrift libthrift-0.17.0 libgrpc++1.51 libgrpc29 libprotobuf32 libboost-dev libboost-system-dev libboost-thread-dev libprotoc-dev protobuf-compiler python3-protobuf libgrpc++-dev libgrpc-dev protobuf-compiler-grpc python3-grpcio
+
+COPY \
+{% for deb in docker_poesyncd_brcm_debs.split(' ') -%}
+debs/{{ deb }}{{' '}}
+{%- endfor -%}
+debs/
+
+RUN dpkg -i \
+{% for deb in docker_poesyncd_brcm_debs.split(' ') -%}
+debs/{{ deb }}{{' '}}
+{%- endfor %}
+
+COPY ["start.sh", "/usr/bin/"]
+COPY ["supervisord.conf", "/etc/supervisor/conf.d/"]
+#COPY ["files/supervisor-proc-exit-listener", "/usr/bin"]
+COPY ["critical_processes", "/etc/supervisor/"]
+
+## Clean up
+RUN apt-get clean -y; apt-get autoclean -y; apt-get autoremove -y
+
+ENTRYPOINT ["/usr/local/bin/supervisord"]
diff --git a/platform/broadcom/docker-poesyncd-brcm/critical_processes b/platform/broadcom/docker-poesyncd-brcm/critical_processes
new file mode 100644
index 000000000..bdd6903c5
--- /dev/null
+++ b/platform/broadcom/docker-poesyncd-brcm/critical_processes
@@ -0,0 +1 @@
+program:syncd
diff --git a/platform/broadcom/docker-poesyncd-brcm/start.sh b/platform/broadcom/docker-poesyncd-brcm/start.sh
new file mode 100755
index 000000000..1e1a33f32
--- /dev/null
+++ b/platform/broadcom/docker-poesyncd-brcm/start.sh
@@ -0,0 +1,14 @@
+#!/usr/bin/env bash
+
+HWSKU_DIR=/usr/share/sonic/hwsku
+
+mkdir -p /etc/sai.d/
+
+# Create/Copy the poe.profile to /etc/sai.d/poe.profile
+if [ -f $HWSKU_DIR/poe.profile.j2 ]; then
+    sonic-cfggen -d -t $HWSKU_DIR/poe.profile.j2 > /etc/sai.d/poe.profile
+else
+    if [ -f $HWSKU_DIR/poe.profile ]; then
+        cp $HWSKU_DIR/poe.profile /etc/sai.d/poe.profile
+    fi
+fi
diff --git a/platform/broadcom/docker-poesyncd-brcm/supervisord.conf b/platform/broadcom/docker-poesyncd-brcm/supervisord.conf
new file mode 100644
index 000000000..7173cdb1e
--- /dev/null
+++ b/platform/broadcom/docker-poesyncd-brcm/supervisord.conf
@@ -0,0 +1,50 @@
+[supervisord]
+logfile_maxbytes=1MB
+logfile_backups=2
+nodaemon=true
+
+[eventlistener:dependent-startup]
+command=python3 -m supervisord_dependent_startup
+autostart=true
+autorestart=unexpected
+startretries=0
+exitcodes=0,3
+events=PROCESS_STATE
+buffer_size=1024
+
+[eventlistener:supervisor-proc-exit-listener]
+command=/usr/local/bin/supervisor-proc-exit-listener --container-name poesyncd
+events=PROCESS_STATE_EXITED,PROCESS_STATE_RUNNING
+autostart=true
+autorestart=unexpected
+buffer_size=1024
+
+[program:rsyslogd]
+command=/usr/sbin/rsyslogd -n -iNONE
+priority=1
+autostart=false
+autorestart=unexpected
+stdout_logfile=syslog
+stderr_logfile=syslog
+dependent_startup=true
+
+[program:start]
+command=/usr/bin/start.sh
+priority=2
+autostart=false
+autorestart=false
+startsecs=0
+stdout_logfile=syslog
+stderr_logfile=syslog
+dependent_startup=true
+dependent_startup_wait_for=rsyslogd:running
+
+[program:syncd]
+command=/usr/bin/syncd -s -p /etc/sai.d/poe.profile -x /usr/share/sonic/hwsku/context_config.json -g 1
+priority=3
+autostart=false
+autorestart=false
+stdout_logfile=syslog
+stderr_logfile=syslog
+dependent_startup=true
+dependent_startup_wait_for=start:exited
