 #define CFG_LAG_INTF_TABLE_NAME           "PORTCHANNEL_INTERFACE"
 #define CFG_VLAN_INTF_TABLE_NAME          "VLAN_INTERFACE"
@@ -495,6 +500,10 @@ namespace swss {
 
