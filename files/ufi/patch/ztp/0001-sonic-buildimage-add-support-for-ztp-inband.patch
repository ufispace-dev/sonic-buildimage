From 4cde56d2e49a25cf89b3e33a8d4433bbf3cd0795 Mon Sep 17 00:00:00 2001
From: "feng.cf.lee" <feng.cf.lee@ufispace.com>
Date: Fri, 26 Jun 2026 11:10:00 +0800
Subject: [PATCH] sonic-buildimage enable ztp and dhcp l2

---
 files/image_config/copp/copp_cfg.j2 | 2 +-
 rules/config                        | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/files/image_config/copp/copp_cfg.j2 b/files/image_config/copp/copp_cfg.j2
index fc2002cff..d319ac4e5 100755
--- a/files/image_config/copp/copp_cfg.j2
+++ b/files/image_config/copp/copp_cfg.j2
@@ -107,7 +107,7 @@
 		    "trap_group": "queue4_group3"
 	    },
 	    "dhcp_relay": {
-		    "trap_ids": "dhcp,dhcpv6",
+		    "trap_ids": "dhcp,dhcp_l2,dhcpv6,dhcpv6_l2",
 		    "trap_group": "queue4_group3"
 	    },
 	    "udld": {
diff --git a/rules/config b/rules/config
index c660c2d31..19d40e79c 100644
--- a/rules/config
+++ b/rules/config
@@ -87,7 +87,7 @@ BMC_NOS_ACCOUNT_USERNAME ?= yormnAnb
 BMC_ROOT_ACCOUNT_DEFAULT_PASSWORD ?=
 
 # ENABLE_ZTP - installs Zero Touch Provisioning support.
-# ENABLE_ZTP = y
+ENABLE_ZTP = y
 
 # INCLUDE_PDE - Enable platform development environment
 # INCLUDE_PDE = y
-- 
2.25.1

