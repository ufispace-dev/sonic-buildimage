 #define CFG_PORT_CABLE_LEN_TABLE_NAME "CABLE_LENGTH"
 #define CFG_SEND_TO_INGRESS_PORT_TABLE_NAME  "SEND_TO_INGRESS_PORT"
 #define CFG_GEARBOX_TABLE_NAME           "GEARBOX"
+#define CFG_POE_TABLE_NAME               "POE_PORT"
