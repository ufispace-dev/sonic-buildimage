---
 common/database_config.json | 15 +++++++++++++++
 common/schema.h             |  9 +++++++++
 2 files changed, 24 insertions(+)

diff --git a/common/database_config.json b/common/database_config.json
index 67b5cda88..ce394cbb1 100644
--- a/common/database_config.json
+++ b/common/database_config.json
@@ -91,6 +91,21 @@
             "id" : 14,
             "separator": ":",
             "instance" : "redis"
+        },
+        "POE_ASIC_DB" : {
+            "id" : 21,
+            "separator": ":",
+            "instance" : "redis"
